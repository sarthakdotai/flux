# Optional settings. Copy to config.env (git-ignored) and edit. Read by mac/build.sh,
# and by deploy.sh / flux-open.sh if you run your own server.

# Your app ID. macOS remembers notification permission per app ID, so set it once and keep it.
FLUX_BUNDLE_ID=com.example.flux

# Signing identity for the Mac app, from: security find-identity -v -p codesigning
# macOS blocks notifications from unsigned apps. If left out, the build uses the first
# "Apple Development" identity it finds.
# FLUX_SIGN_IDENTITY="Apple Development: you@example.com (ABCDE12345)"

# Your own server (advanced, optional). Set both to make it the Mac app's default.
# FLUX_HOST=ubuntu@203.0.113.10
# FLUX_SSH_KEY=~/.ssh/id_ed25519
