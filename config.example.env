# Optional. Only needed if you run Flux on your own server.
# Copy to config.env (git-ignored) and fill in. Used by deploy.sh, flux-open.sh and mac/build.sh
# (which makes this server the Mac app's default; without it the app runs the server locally).

# The server Flux runs on, as user@host, and the SSH key that reaches it.
FLUX_HOST=ubuntu@203.0.113.10
FLUX_SSH_KEY=~/.ssh/id_ed25519

# Bundle identifier for the Mac app. macOS ties notification permission to it,
# so keep it the same once you've allowed notifications.
FLUX_BUNDLE_ID=com.example.flux
